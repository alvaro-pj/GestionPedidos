@page "/clientes/nuevo"
@inject ClienteService ClienteSvc
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Nuevo Cliente</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Nuevo Cliente</MudText>

<ClienteFormulario Cliente="cliente"
				   TextoBotonGuardar="Guardar"
				   OnValidSubmit="GuardarAsync"
				   OnCancel="Cancelar">

</ClienteFormulario>
@code {
	private Cliente cliente = new();

	private async Task GuardarAsync()
	{
		await ClienteSvc.CrearAsync(cliente);
		Snackbar.Add($"Cliente '{cliente.Nombre}' creado", Severity.Success);
		Nav.NavigateTo("/clientes");
	}

	private void Cancelar()
	{
		Nav.NavigateTo("/clientes");
	}
}
