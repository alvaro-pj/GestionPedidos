@page "/"

<PageTitle>Home</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Bienvenido</MudText>
<MudText Class="mb-4">Prueba de MudBlazor funcionando.</MudText>

<MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Saludar">
    Salúdame
</MudButton>

@if (!string.IsNullOrEmpty(mensaje))
{
    <MudAlert Severity="Severity.Success" Class="mt-4">@mensaje</MudAlert>
}

@code {
    private string mensaje = "";

    private void Saludar()
    {
        mensaje = $"¡Hola, Álvaro! Son las {DateTime.Now:HH:mm:ss}";
    }
}