@page "/clientes" 
@inject ClienteService ClienteSvc
@inject ISnackbar Snackbar
@inject IDialogService DialogSvc

<PageTitle>Clientes</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Clientes</MudText>

<MudButton Variant="Variant.Filled" 
           Color="Color.Primary"
           StartIcon="@Icons.Material.Filled.Add"
           Href="/clientes/nuevo"
           Class="mb-4">
    Nuevo cliente
</MudButton>

@if (clientes == null)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (!clientes.Any())
{
    <MudAlert Severity="Severity.Info">No hay clientes todavía.</MudAlert>
}
else
{
    <MudTable Items="clientes" Context="cliente" Hover="true" Striped="true">
        <HeaderContent>
            <MudTh>Nombre</MudTh>
            <MudTh>Tipo</MudTh>
            <MudTh>CIF/DNI</MudTh>
            <MudTh>Teléfono</MudTh>
            <MudTh>Población</MudTh>
            <MudTh Style="text-align:right">Acciones</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Nombre">@cliente.Nombre</MudTd>
            <MudTd DataLabel="Tipo">@cliente.Tipo</MudTd>
            <MudTd DataLabel="CIF/DNI">@cliente.Cif</MudTd>
            <MudTd DataLabel="Teléfono">@cliente.Telefono</MudTd>
            <MudTd DataLabel="Población">@cliente.Poblacion</MudTd>
            <MudTd DataLabel="Acciones" Style="text-align:right">
                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Color="Color.Primary"
                               Size="Size.Small"
                               Href="@($"/clientes/editar/{cliente.Id}")" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Color="Color.Error"
                               Size="Size.Small"
                               OnClick="@(() => ConfirmarDesactivarAsync(cliente))" />
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private List<Cliente>? clientes;

    protected override async Task OnInitializedAsync()
    {
        await RecargarClientesAsync();
    }

    private async Task RecargarClientesAsync()
    {
        clientes = await ClienteSvc.ObtenerActivosAsync();
    }

    private async Task ConfirmarDesactivarAsync(Cliente cliente)
    {
        var parametros = new DialogParameters<ConfirmarDialogo>
    {
        { x => x.Titulo, "¿Desactivar cliente?" },
        { x => x.Mensaje, $"El cliente '{cliente.Nombre}' se marcará como inactivo. Podrás recuperarlo más tarde." },
        { x => x.TextoConfirmar, "Desactivar" }
    };

        var opciones = new DialogOptions { CloseOnEscapeKey = true };

        var dialog = await DialogSvc.ShowAsync<ConfirmarDialogo>("Confirmar", parametros, opciones);
        var resultado = await dialog.Result;

        if (resultado is not null && !resultado.Canceled)
        {
            await ClienteSvc.DesactivarAsync(cliente.Id);
            Snackbar.Add($"Cliente '{cliente.Nombre}' desactivado", Severity.Info);
            await RecargarClientesAsync();
        }
    }
}