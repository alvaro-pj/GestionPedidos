@page "/clientes" 
@using GestionPedidos.Data
@using GestionPedidos.Models
@using Microsoft.EntityFrameworkCore
@using GestionPedidos.Services
@inject ClienteService ClienteSvc

<PageTitle>Clientes</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Clientes</MudText>

<MudButton Variant="Variant.Filled" 
           Color="Color.Primary"
           StartIcon="@Icons.Material.Filled.Add"
           Href="/clientes/nuevo"
           Class="mb-4">
    Nuevo cliente
</MudButton>

@if (clientes == null)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (!clientes.Any())
{
    <MudAlert Severity="Severity.Info">No hay clientes todavía.</MudAlert>
}
else
{
    <MudTable Items="clientes" Context="cliente" Hover="true" Striped="true">
        <HeaderContent>
            <MudTh>Nombre</MudTh>
            <MudTh>Tipo</MudTh>
            <MudTh>CIF/DNI</MudTh>
            <MudTh>Teléfono</MudTh>
            <MudTh>Población</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Nombre">@cliente.Nombre</MudTd>
            <MudTd DataLabel="Tipo">@cliente.Tipo</MudTd>
            <MudTd DataLabel="CIF/DNI">@cliente.Cif</MudTd>
            <MudTd DataLabel="Teléfono">@cliente.Telefono</MudTd>
            <MudTd DataLabel="Población">@cliente.Poblacion</MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private List<Cliente>? clientes;

    protected override async Task OnInitializedAsync()
    {
        clientes = await ClienteSvc.ObtenerActivosAsync();
    }
}