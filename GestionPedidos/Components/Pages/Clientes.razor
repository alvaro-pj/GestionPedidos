@page "/clientes" 
@rendermode InteractiveServer
@using GestionPedidos.Data
@using GestionPedidos.Models
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db

<PageTitle>Clientes</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Clientes</MudText>

@if (clientes == null)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (!clientes.Any())
{
    <MudAlert Severity="Severity.Info">No hay clientes todavía.</MudAlert>
}
else
{
    <MudTable Items="clientes" Hover="true" Striped="true">
        <HeaderContent>
            <MudTh>Nombre</MudTh>
            <MudTh>Tipo</MudTh>
            <MudTh>CIF/DNI</MudTh>
            <MudTh>Teléfono</MudTh>
            <MudTh>Población</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Nombre">@context.Nombre</MudTd>
            <MudTd DataLabel="Tipo">@context.Tipo</MudTd>
            <MudTd DataLabel="CIF/DNI">@context.Cif</MudTd>
            <MudTd DataLabel="Teléfono">@context.Telefono</MudTd>
            <MudTd DataLabel="Población">@context.Poblacion</MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private List<Cliente>? clientes;

    protected override async Task OnInitializedAsync()
    {
        clientes = await Db.Clientes
            .OrderBy(c => c.Nombre)
            .ToListAsync();
    }
}