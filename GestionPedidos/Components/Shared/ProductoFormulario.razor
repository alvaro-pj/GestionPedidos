<EditForm Model="Producto" OnValidSubmit="OnValidSubmitAsync">
    <DataAnnotationsValidator />

    <MudGrid>
        <MudItem xs="12" md="8">
            <MudTextField @bind-Value="Producto.Nombre"
                          Label="Nombre"
                          Required="true"
                          For="@(() => Producto.Nombre)" />
        </MudItem>

        <MudItem xs="12" md="4">
            <MudNumericField @bind-Value="Producto.PrecioBase"
                              Label="Precio base"
                              Format="F2"
                              Adornment="Adornment.End"
                              AdornmentText="€"
                              For="@(() => Producto.PrecioBase)" />
        </MudItem>

        <MudItem xs="12">
            <MudTextField @bind-Value="Producto.Descripcion"
                          Label="Descripción"
                          Lines="3"
                          For="@(() => Producto.Descripcion)" />
        </MudItem>

        <MudItem xs="12" Class="d-flex gap-2 justify-end">
            <MudButton Variant="Variant.Text"
                       Color="Color.Default"
                       OnClick="OnCancel">
                Cancelar
            </MudButton>
            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary">
                @TextoBotonGuardar
            </MudButton>
        </MudItem>
    </MudGrid>
</EditForm>

@code {
    [Parameter, EditorRequired]
    public Producto Producto { get; set; } = null!;

    [Parameter]
    public string TextoBotonGuardar { get; set; } = "Guardar";

    [Parameter]
    public EventCallback OnValidSubmit { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private async Task OnValidSubmitAsync()
    {
        if (OnValidSubmit.HasDelegate)
            await OnValidSubmit.InvokeAsync();
    }
}
